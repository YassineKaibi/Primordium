diff -ruN -x '*.orig' -x '*.rej' a/src/sim/probe.rs b/src/sim/probe.rs
--- a/src/sim/probe.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/sim/probe.rs	2026-09-27 03:15:45.733961602 +0100
@@ -0,0 +1,58 @@
+// LAB-ONLY instrumentation. Thread-local counters incremented from the sim.
+use std::cell::RefCell;
+
+#[derive(Debug, Clone, Default)]
+pub struct Probe {
+    pub actions: [u64; 6], // Reproduce, Attack, Flee, Move, Share, Idle (chosen)
+    pub births: u64,
+    pub repro_blocked: u64,
+    pub attacks: u64,
+    pub dmg_to_def: f64,
+    pub dmg_to_att: f64,
+    pub combat_kills: u64,        // defenders pushed to <=0 by an attack
+    pub combat_attacker_deaths: u64, // attackers killed by retaliation
+    pub deaths: u64,
+    pub decay_deposited: f64,
+    pub photo_in: f64,
+    pub thermo_in: f64,
+    pub scav_in: f64,
+    pub metab: f64,
+    pub venom_dmg: f64,
+    pub toxin_dmg: f64,
+    pub cap_waste: f64,
+    pub dormant: u64,
+    pub phase_ns: [u64; 8],
+    pub shared: f64,
+    pub starve_deaths: u64,
+    pub sun_used_sum: f64,    // sunlight value energy step actually used (next grid)
+    pub sun_current_sum: f64, // sunlight on the current grid at same tile
+    pub decay_used_sum: f64,
+    pub decay_current_sum: f64,
+    pub energy_samples: u64,
+    pub phase_transitions: u64,
+    pub child_energy: f64,
+    pub same_lineage_attacks: u64,
+    pub attack_gdist_sum: f64,
+    pub child_gdist_sum: f64,
+    pub child_mutated_bytes: u64,
+    // Heading bias: signed angle between the chosen move and the genome's
+    // direction_bias, wrapped to (-pi, pi]. Split interior vs grid-edge cells.
+    pub move_err_sum: f64,
+    pub move_err_n: u64,
+    pub edge_move_err_sum: f64,
+    pub edge_move_err_abs_sum: f64,
+    pub edge_move_n: u64,
+    pub interior_move_err_abs_sum: f64,
+}
+
+thread_local! {
+    pub static PROBE: RefCell<Probe> = RefCell::new(Probe::default());
+}
+
+pub fn with<F: FnOnce(&mut Probe)>(f: F) {
+    PROBE.with(|p| f(&mut p.borrow_mut()));
+}
+
+pub fn take() -> Probe {
+    PROBE.with(|p| std::mem::take(&mut *p.borrow_mut()))
+}
