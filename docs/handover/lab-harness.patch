     /// Total number of live cells (excluding sentinel).
+    /// LAB: (id, cell) for every living cell.
+    pub fn live(&self) -> Vec<(u32, &Cell)> {
+        (1..self.cells.len() as u32)
+            .filter(|&id| self.cells[id as usize].is_alive())
+            .map(|id| (id, &self.cells[id as usize]))
+            .collect()
+    }
+
+    /// LAB: (cells on tiles whose position field != tile coords, alive pool cells not on any tile)
+    pub fn integrity(&self) -> (u32, u32) {
+        let mut mismatch = 0;
+        let mut on_tile = vec![false; self.cells.len()];
+        for y in 0..self.height as u16 {
+            for x in 0..self.width as u16 {
+                let t = self.current_tile(x, y);
+                if t.cell_id != 0 {
+                    on_tile[t.cell_id as usize] = true;
+                    if self.cells[t.cell_id as usize].position != (x, y) { mismatch += 1; }
+                }
+            }
+        }
+        let ghosts = (1..self.cells.len())
+            .filter(|&i| self.cells[i].is_alive() && !on_tile[i])
+            .count() as u32;
+        (mismatch, ghosts)
+    }
